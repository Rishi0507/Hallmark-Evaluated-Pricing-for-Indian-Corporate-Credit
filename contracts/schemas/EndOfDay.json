{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallmark.dev/schemas/EndOfDay.json",
  "title": "EndOfDay",
  "description": "Control event published after every input for a business date has been published.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "source",
    "key",
    "producedAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Deterministic SHA-256 of type, key, business date and payload; used for de-duplication."
    },
    "eventType": {
      "const": "EndOfDay"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "businessDate",
        "counts"
      ],
      "properties": {
        "businessDate": {
          "type": "string",
          "format": "date"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "curveAvailable": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": false
}
