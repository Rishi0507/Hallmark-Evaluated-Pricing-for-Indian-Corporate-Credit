{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallmark.dev/schemas/SettlementRecord.json",
  "title": "SettlementRecord",
  "description": "Clearing corporation settlement (or fail) for one ISIN and trade date on one settlement date.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "source",
    "key",
    "producedAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Deterministic SHA-256 of type, key, business date and payload; used for de-duplication."
    },
    "eventType": {
      "const": "SettlementRecord"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "isin",
        "tradeDate",
        "settlementDate",
        "status",
        "nominalValueInr"
      ],
      "properties": {
        "isin": {
          "type": "string",
          "pattern": "^IN[A-Z0-9]{9}[0-9]$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "tradeDate": {
          "type": "string",
          "format": "date"
        },
        "settlementDate": {
          "type": "string",
          "format": "date"
        },
        "instrumentClass": {
          "enum": [
            "BOND",
            "CP",
            "CD",
            "GSEC",
            "OTHER"
          ]
        },
        "listing": {
          "enum": [
            "LISTED",
            "UNLISTED",
            null
          ]
        },
        "counterpartyClass": {
          "enum": [
            "MANDATORY",
            "NON_MANDATORY",
            null
          ]
        },
        "status": {
          "enum": [
            "SETTLED",
            "FAILED"
          ]
        },
        "quantity": {
          "type": [
            "integer",
            "null"
          ]
        },
        "nominalValueInr": {
          "type": "number"
        },
        "wap": {
          "type": [
            "number",
            "null"
          ]
        },
        "way": {
          "type": [
            "number",
            "null"
          ]
        },
        "faceValueInr": {
          "type": [
            "number",
            "null"
          ]
        },
        "denominationClass": {
          "enum": [
            "RETAIL",
            "HNI",
            "INSTITUTIONAL",
            "UNKNOWN"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
