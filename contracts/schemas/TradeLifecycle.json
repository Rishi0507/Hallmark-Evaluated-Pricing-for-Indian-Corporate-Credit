{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallmark.dev/schemas/TradeLifecycle.json",
  "title": "TradeLifecycle",
  "description": "State of one ISIN and trade date in the reporting to settlement lifecycle.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "source",
    "key",
    "producedAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Deterministic SHA-256 of type, key, business date and payload; used for de-duplication."
    },
    "eventType": {
      "const": "TradeLifecycle"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "isin",
        "tradeDate",
        "state"
      ],
      "properties": {
        "isin": {
          "type": "string",
          "pattern": "^IN[A-Z0-9]{9}[0-9]$"
        },
        "tradeDate": {
          "type": "string",
          "format": "date"
        },
        "state": {
          "enum": [
            "REPORTED",
            "SETTLING",
            "SETTLED",
            "PARTIALLY_SETTLED",
            "FAILED",
            "UNSETTLED",
            "OVER_SETTLED",
            "SETTLED_UNREPORTED"
          ]
        },
        "reportedFaceLakh": {
          "type": [
            "number",
            "null"
          ]
        },
        "settledFaceLakh": {
          "type": "number"
        },
        "failedFaceLakh": {
          "type": "number"
        },
        "settledShare": {
          "type": [
            "number",
            "null"
          ]
        },
        "lastSettlementDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  },
  "additionalProperties": false
}
