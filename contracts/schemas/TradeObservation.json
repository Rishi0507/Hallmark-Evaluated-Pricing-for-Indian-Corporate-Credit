{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hallmark.dev/schemas/TradeObservation.json",
  "title": "TradeObservation",
  "description": "A validated price observation used by the pricing service.",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "source",
    "key",
    "producedAt",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "description": "Deterministic SHA-256 of type, key, business date and payload; used for de-duplication."
    },
    "eventType": {
      "const": "TradeObservation"
    },
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "businessDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "producedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": [
        "isin",
        "tradeDate",
        "cleanPrice",
        "yieldPct",
        "faceValueLakh",
        "sizeClass"
      ],
      "properties": {
        "isin": {
          "type": "string",
          "pattern": "^IN[A-Z0-9]{9}[0-9]$"
        },
        "tradeDate": {
          "type": "string",
          "format": "date"
        },
        "cleanPrice": {
          "type": "number"
        },
        "yieldPct": {
          "type": "number"
        },
        "faceValueLakh": {
          "type": "number"
        },
        "sizeClass": {
          "enum": [
            "INSTITUTIONAL",
            "RETAIL"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recomputedYieldPct": {
          "type": [
            "number",
            "null"
          ]
        },
        "settledMandatoryShare": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
